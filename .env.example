# Server only: never put the API key in a VITE_ variable.
GEMINI_API_KEY=
FILE_SEARCH_STORE_NAME=
# auto uses bundled college evidence first; always forces remote File Search.
FILE_SEARCH_MODE=auto
# Bounded public-page lookup for missing specifics or explicit freshness requests.
# Approved official pages only; eight seconds maximum. No additional AI call or API key.
LIVE_WEBSITE_ENABLED=true
# Free-tier eligible catalog; check actual access with npm run check:models.
MODEL_LADDER_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
MODEL_LADDER_DEEP=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
FAST_THINKING=MINIMAL
DEEP_THINKING=LOW
CACHE_ENABLED=true
# Exact reviewed variants by default; fuzzy matching is experimental.
BANK_FUZZY_MATCH=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://commecs-ai-assistant.vercel.app
# Never bypass provider quotas or enable billing automatically.
# Development-only failure simulation: 429-daily, 429-minute, 503
FAKE_UPSTREAM_ERROR=
VITE_API_BASE_URL=
VITE_USE_MOCK=false
# Optional shared quota/concurrency gate. Set BOTH values on the server only.
# Without them the existing limits apply per process, not across all instances.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# LIVE_REQUESTS_PER_HOUR=30
# TRAFFIC_NAMESPACE=commecs-production
# Optional private /api/metrics access: a random token of at least 32 characters.
# OPS_METRICS_TOKEN=
