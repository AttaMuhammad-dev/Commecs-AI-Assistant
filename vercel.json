{
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "supportsCancellation": true,
      "includeFiles": "{server/data/verified-answers.json,knowledge/.filesearch.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
