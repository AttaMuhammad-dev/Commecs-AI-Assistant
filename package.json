{
  "name": "commecs-chatbot",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "npm run knowledge:build && tsc -b && vite build && npm run build:server",
    "preview": "vite preview",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:dry": "tsx scripts/ingest.ts --dry-run",
    "index:knowledge": "tsx scripts/index-knowledge.ts",
    "index:dry": "tsx scripts/index-knowledge.ts --dry-run",
    "test:ingest": "vitest run scripts",
    "eval": "tsx eval/run-eval.ts",
    "answers:draft": "tsx scripts/draftAnswers.ts",
    "answers:check": "tsx scripts/checkAnswers.ts",
    "test": "vitest run",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "check:models": "tsx scripts/checkModels.ts",
    "verify": "npm run typecheck:server && npm test && npm run build",
    "start": "node dist-server/server/start.js",
    "test:live": "tsx scripts/smoke.ts",
    "guide:build": "node scripts/buildLocalGuide.mjs && node scripts/buildLocalKnowledge.mjs",
    "knowledge:build": "node scripts/buildLocalKnowledge.mjs",
    "build:server": "tsc -p tsconfig.runtime.json",
    "check:live": "node scripts/check-live.mjs",
    "test:runtime": "npm run build:server && node scripts/check-runtime.mjs",
    "refresh:faculty": "node scripts/refresh-faculty.mjs",
    "test:faculty": "npm run build:server && node scripts/check-faculty.mjs",
    "test:presentation": "npm run build:server && node scripts/check-presentation.mjs --slow"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.1.1",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/noto-nastaliq-urdu": "^5.1.1",
    "@google/genai": "^2.23.0",
    "@hono/node-server": "^2.1.1",
    "dotenv": "^18.0.1",
    "hono": "^4.13.8",
    "lucide-react": "^0.474.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.7.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^1.4.0"
  }
}
